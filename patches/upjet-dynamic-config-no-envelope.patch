+
+func cloneDynamicMap(m map[string]any) map[string]any {
+	cp := make(map[string]any, len(m))
+	for k, v := range m {
+		cp[k] = cloneDynamicValue(v)
+	}
+	return cp
+}
+
+func cloneDynamicValue(v any) any {
+	switch t := v.(type) {
+	case map[string]any:
+		return cloneDynamicMap(t)
+	case []any:
+		cp := make([]any, len(t))
+		for i, item := range t {
+			cp[i] = cloneDynamicValue(item)
+		}
+		return cp
+	default:
+		return v
+	}
